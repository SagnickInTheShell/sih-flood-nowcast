# ── Pilot ward mode ──────────────────────────────────────────────
# synthetic = deterministic offline-safe demo ward (default, always works)
# real      = ingest an actual bounding box via OSM + SRTM (see docs/DATA_SOURCES.md)
PILOT_MODE=synthetic

# Only used when PILOT_MODE=real. Format: "min_lon,min_lat,max_lon,max_lat"
REAL_WARD_BBOX=

# ── Database ─────────────────────────────────────────────────────
# sqlite   = zero-dependency local dev (no Docker/PostGIS required)
# postgis  = full stack via docker-compose
DB_MODE=sqlite
DATABASE_URL=sqlite:///./flood_nowcast.db
POSTGIS_URL=postgresql+psycopg2://flood:flood@localhost:5432/flood_nowcast

# ── Synthetic ward generation ───────────────────────────────────
SYNTHETIC_SEED=42
GRID_SIZE_CELLS=100
GRID_RESOLUTION_M=20
ANCHOR_LAT=12.9716
ANCHOR_LNG=77.5946

# ── Drainage network assumptions (ASSUMPTION, see gis/drainage_graph.py) ──
DRAIN_DIAMETER_RESIDENTIAL_MM=450
DRAIN_DIAMETER_ARTERIAL_MM=900
DRAIN_DIAMETER_TRUNK_MM=1400
MANNINGS_N_CONCRETE=0.013

# ── Hydrology ────────────────────────────────────────────────────
IA_COEFFICIENT=0.2

# ── Road/flood state thresholds (metres of predicted depth) ───────
DEPTH_THRESHOLD_AT_RISK_M=0.15
DEPTH_THRESHOLD_FLOODED_M=0.30

# ── ML ───────────────────────────────────────────────────────────
MODEL_CHECKPOINT_PATH=./app/ml/checkpoints/gnn_surrogate.pt
MC_DROPOUT_SAMPLES=20

# ── API ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
