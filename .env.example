# ── Pilot ward mode ──────────────────────────────────────────────
# synthetic = deterministic offline-safe demo ward (default, always works)
# real      = ingest an actual bounding box via OSM + a real DEM (see
#             docs/DATA_SOURCES.md) -- fetched automatically on first boot,
#             no manual download needed, but does need network access.
PILOT_MODE=synthetic

# Only used when PILOT_MODE=real. Format: "min_lon,min_lat,max_lon,max_lat"
# Example: Bellandur, Bengaluru -- a real, documented flood-prone area
# (BBMP-listed flooding location, repeated lake-overflow flood news
# coverage; see docs/DATA_SOURCES.md).
# REAL_WARD_BBOX=77.655,12.915,77.680,12.940
REAL_WARD_BBOX=

# ── Database ─────────────────────────────────────────────────────
# sqlite   = zero-dependency local dev (no Docker/PostGIS required)
# postgis  = full stack via docker-compose
DB_MODE=sqlite
DATABASE_URL=sqlite:///./flood_nowcast.db
POSTGIS_URL=postgresql+psycopg2://flood:flood@localhost:5432/flood_nowcast

# ── Synthetic ward generation ───────────────────────────────────
SYNTHETIC_SEED=42
GRID_SIZE_CELLS=100
GRID_RESOLUTION_M=20
ANCHOR_LAT=12.9716
ANCHOR_LNG=77.5946

# ── Drainage network assumptions (ASSUMPTION, see gis/drainage_graph.py) ──
DRAIN_DIAMETER_RESIDENTIAL_MM=450
DRAIN_DIAMETER_ARTERIAL_MM=900
DRAIN_DIAMETER_TRUNK_MM=1400
MANNINGS_N_CONCRETE=0.013

# ── Hydrology ────────────────────────────────────────────────────
IA_COEFFICIENT=0.2

# ── Road/flood state thresholds (metres of predicted depth) ───────
DEPTH_THRESHOLD_AT_RISK_M=0.15
DEPTH_THRESHOLD_FLOODED_M=0.30

# ── ML ───────────────────────────────────────────────────────────
# Each PILOT_MODE gets its own checkpoint automatically, in a subdirectory
# named after the mode (e.g. ./app/ml/checkpoints/synthetic/gnn_surrogate.pt,
# .../real/gnn_surrogate.pt) -- trained fresh on first boot in that mode if
# missing, so a synthetic-trained model is never silently reused for real
# ward inference or vice versa.
MODEL_CHECKPOINT_PATH=./app/ml/checkpoints/gnn_surrogate.pt
MC_DROPOUT_SAMPLES=20

# ── API ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
